#!/usr/bin/env bash
# AI Ledger: runs after every commit. Never blocks anything.
#  1. Local mode: remembers how many entries exist, so the next commit needs a new one,
#     and backs up .ai_ledger/ into .git/ai-ledger-backup (survives `git clean -x`).
#  2. Shows the newest entry's "Request vs Result", so you see what the AI did.
#  3. Reminds you to run the ledger review when the last one was 14+ days ago.
cd "$(git rev-parse --show-toplevel)" || exit 0
LEDGER=.ai_ledger/evolution_log.md
[ -f "$LEDGER" ] || exit 0

# 1. Entry count baseline and backup (local mode only).
if [ "$(git config --get ailedger.mode)" = local ]; then
  cat "$LEDGER" .ai_ledger/archive/*.md 2>/dev/null \
    | grep -cE '^## \[[0-9]{4}-[0-9]{2}-[0-9]{2}' > "$(git rev-parse --git-path ai-ledger-count)"
  BACKUP=$(git rev-parse --git-path ai-ledger-backup)
  rm -rf "$BACKUP" && cp -R .ai_ledger "$BACKUP"
fi

# 2. Summary of the newest entry, only when this commit changed code.
if git diff-tree --root --no-commit-id --name-only -r HEAD | grep -qv '^\.ai_ledger/'; then
  awk '/^## \[[0-9][0-9][0-9][0-9]-/ { head = substr($0, 4); rvr = ""; inside = 0; next }
       /^### Request vs Result[[:space:]]*$/ { inside = 1; next }
       /^### / { inside = 0 }
       inside && NF { rvr = rvr "\n  " $0 }
       END { if (head != "") {
               print "---------------- AI Ledger: latest entry ----------------"
               print head
               print "Request vs Result:" (rvr != "" ? rvr : "\n  (empty)")
               print "Full entry: .ai_ledger/evolution_log.md"
               print "----------------------------------------------------------" } }' "$LEDGER"
fi

# 3. Review reminder. .ai_ledger/last_review holds the time of the last review (seconds since 1970).
STAMP=.ai_ledger/last_review
NOW=$(date +%s)
LAST=$(head -n 1 "$STAMP" 2>/dev/null | tr -dc '0-9')
if [ -z "$LAST" ]; then
  echo "$NOW" > "$STAMP"   # first run: start the clock
else
  AGE=$(( (NOW - LAST) / 86400 ))
  if [ "$AGE" -ge 14 ]; then
    echo "Reminder: your last ledger review was $AGE days ago. Ask your AI:"
    echo "    \"Follow .ai_ledger/review_prompt.md\""
  fi
fi
exit 0
